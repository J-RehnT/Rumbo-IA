# Copia este archivo a .env y completa los valores.
PORT=3000

# Secreto para firmar los JWT. Cámbialo por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRA=7d

# Rondas de bcrypt para hashear contraseñas (10–12 es razonable).
BCRYPT_ROUNDS=10

# Tutor IA con DeepSeek (https://platform.deepseek.com). Sin clave, el tutor responde con ejemplos (modo demo).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Modelos: deepseek-flash (rápido y económico) o deepseek-v4-pro.
TUTOR_MODELO=deepseek-flash

# Supabase (todavía no se usa: ver src/db/index.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
