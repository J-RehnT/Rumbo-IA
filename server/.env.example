# Copia este archivo a .env y completa los valores.
PORT=3000

# Secreto para firmar los JWT. Cámbialo por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRA=7d

# Rondas de bcrypt para hashear contraseñas (10–12 es razonable).
BCRYPT_ROUNDS=10

# Tutor IA. Sin clave, el tutor responde con ejemplos (modo demo).
ANTHROPIC_API_KEY=
TUTOR_MODELO=claude-opus-5-5
TUTOR_ESFUERZO=low

# Supabase (todavía no se usa: ver src/db/index.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
